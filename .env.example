# Renombra este archivo a .env y completa los valores reales.
# DATABASE_URL: connection string de NeonDB (consola de Neon).
#   Ejemplo: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: misma conexion pero sin el driver serverless (para migraciones).
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=

# Origen(es) permitidos por CORS, separados por coma. Default: localhost:3000.
# En produccion poner la URL exacta del frontend, nunca '*'.
#   Ejemplo: https://mi-frontend.vercel.app,https://mi-frontend.dominio.com
CORS_ORIGIN=

# ─── IA (agente COPILOT / chat del editor) ───────────────────────────────
# Modo de generacion:
#   mock          -> proveedor de desarrollo deterministico (sin GPU). Default.
#   fastapi       -> llama al Space ZeroGPU (gradio.Server/FastAPI, POST /generate).
#   gradio-space  -> misma Space pero por el protocolo Gradio (/gradio_api).
#   off           -> IA deshabilitada (error claro al llamar).
AI_MODE=mock
# URL base del Space (sin trailing slash). Es el respaldo para todos los modelos.
#   Ejemplo: https://alex-qwen-space-uml.hf.space
AI_DEFAULT_SPACE=
# URL propia por modelo (opcional, tiene prioridad sobre AI_DEFAULT_SPACE).
# Para agregar un modelo nuevo a futuro:
#   1. Agrega un item en MODELOS_REGISTRO (models.config.ts) con su envVar.
#   2. Define aqui esa variable con la URL de su Space.
#   Ejemplo: AI_SPACE_LLAMA_3_8B=https://usuario-llama-space.hf.space
AI_SPACE_QWEN25_CODER_7B=
# Token de lectura de Hugging Face (requerido solo si el Space es privado).
HF_TOKEN=
# URL del microservicio vision->DSL (Space deploy/ia-diagram-json,
# POST /api/diagram-to-json). Vacia = endpoint de importacion deshabilitado.
#   Ejemplo: https://usuario-ia-diagram-json.hf.space
DIAGRAMA_VISION_URL=
# URL del motor voz->texto (Space AlexSolizDuran/ia-voztotext, Whisper small en
# CPU, POST /api/transcribe). Vacia = microfono del chat deshabilitado.
#   Ejemplo: https://alexsolizduran-ia-voztotext.hf.space
STT_URL=
# URL del Space propio de embeddings (tienda-vector-engine, /api/vectorize).
#   Ejemplo: https://usuario-tienda-vector-engine.hf.space
EMBEDDINGS_API_URL=
# Id del modelo por defecto (ver GET /ai/models).
AI_DEFAULT_MODEL=qwen2.5-coder-7b-instruct
# Parametros por defecto de generacion.
AI_DEFAULT_TEMPERATURE=0.2
AI_DEFAULT_TOP_P=0.9
AI_DEFAULT_MAX_TOKENS=512
# Presupuesto extra de tokens para el modo reemplazar (diagramas desde cero).
# Los diagramas completos superan 512 tokens y se truncaban; 1536 probado OK.
AI_MAX_TOKENS_REEMPLAZAR=1536
# Presupuesto de tokens del agente SUPPORT (respuestas cortas de ayuda).
AI_SUPPORT_MAX_TOKENS=512
# Tamano de la cache LRU de respuestas (0 desactiva).
AI_CACHE_SIZE=50
# Timeout de cada llamada al Space (ms).
AI_HTTP_TIMEOUT_MS=120000